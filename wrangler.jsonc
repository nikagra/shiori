{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiori",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiori",
      "database_id": "3b579616-c88e-499e-b410-e8b6180db608",
      "migrations_dir": "migrations",
    }
  ],
  "observability": {
    "enabled": true
  }
}
