{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiori",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shiori",
      "database_id": "3b579616-c88e-499e-b410-e8b6180db608",
      "migrations_dir": "migrations",
    }
  ],
  // Private bucket for the nightly backups. Create it once with
  // `npx wrangler r2 bucket create shiori-backups` before deploying.
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "shiori-backups"
    }
  ],
  // Nightly backup at 03:30 UTC (worker/backup.ts).
  "triggers": {
    "crons": ["30 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
